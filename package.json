{
  "name": "miserecord",
  "productName": "Miserecord",
  "version": "1.6.2",
  "description": "Private peer-to-peer calls, screen sharing and streaming with your friends.",
  "author": "Killerwolf000157",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/Killerwolf000157/Miserecord",
  "repository": {
    "type": "git",
    "url": "https://github.com/Killerwolf000157/Miserecord.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "npm run native && electron-builder --win --publish never",
    "release": "npm run native && electron-builder --win --publish always",
    "native": "cargo build --release --manifest-path native/capture/Cargo.toml"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.killerwolf000157.miserecord",
    "npmRebuild": false,
    "productName": "Miserecord",
    "copyright": "Killerwolf000157",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Miserecord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Miserecord",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Killerwolf000157",
      "repo": "Miserecord",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "native/capture/target/release/miserecord-capture.exe",
        "to": "miserecord-capture.exe"
      }
    ]
  }
}
